# Copy this file to `.env` for local development.

# REST API server (scripts/run_api.py, FastAPI)
# Note: if you also run vLLM on port 8000, set ADSP_API_PORT=8080.
ADSP_API_HOST=0.0.0.0
ADSP_API_PORT=8000
ADSP_API_RELOAD=true
ADSP_API_RUN_MODE=uvicorn
ADSP_API_WORKERS=1
ADSP_API_DEBUG=false
# Case-insensitive: INFO, DEBUG, ERROR, WARNING, TRACE, CRITICAL
ADSP_API_LOG_LEVEL=INFO
ADSP_API_TITLE=Lavazza AI Personas API
ADSP_API_VERSION=0.1.0
# GPU settings for the `api` service in `docker compose up`
ADSP_API_GPU_REQUEST=all
ADSP_API_GPU_VISIBLE_DEVICES=all
ADSP_API_GPU_DRIVER_CAPABILITIES=compute,utility

# If true, protected endpoints require X-User and X-Token headers.
ADSP_REQUIRE_AUTH=false

# Application services
ADSP_INGESTION_BUCKET=uploads
ADSP_REPORTS_DIR=reports/api

# Runtime LLM backend:
# - `stub`: no external server required (default)
# - `openai`: call an OpenAI-compatible endpoint (e.g., vLLM)
ADSP_LLM_BACKEND=openai

# OpenAI-compatible runtime model settings (only used when ADSP_LLM_BACKEND=openai)
ADSP_LLM_BASE_URL=http://localhost:8000/v1
ADSP_LLM_MODEL=
ADSP_LLM_API_KEY=EMPTY

# Optional generation knobs
ADSP_LLM_TEMPERATURE=0.2
ADSP_LLM_MAX_TOKENS=512
ADSP_LLM_TIMEOUT=60

# Orchestrator relevance filtering (history + retrieved context)
ADSP_CONTEXT_FILTER_ENABLED=true
ADSP_CONTEXT_FILTER_BACKEND=heuristic
ADSP_CONTEXT_FILTER_MAX_HISTORY=10
ADSP_CONTEXT_FILTER_MAX_BLOCKS=10
ADSP_CONTEXT_FILTER_MIN_COVERAGE=0.2
ADSP_CONTEXT_FILTER_TIMEOUT=30

# OpenAI-compatible context filter model settings (only used when ADSP_CONTEXT_FILTER_BACKEND=openai)
# Defaults to ADSP_LLM_* / VLLM_* if left blank.
ADSP_CONTEXT_FILTER_BASE_URL=
ADSP_CONTEXT_FILTER_MODEL=
ADSP_CONTEXT_FILTER_API_KEY=

# Persona data locations (override if you store outputs elsewhere)
ADSP_PERSONAS_DIR=data/processed/personas/individual
ADSP_PERSONA_TRAITS_DIR=data/processed/personas/common_traits

# Fact-data RAG runtime (used by orchestrator startup)
ADSP_FACTDATA_RAG_ENABLED=true
ADSP_FACTDATA_MARKDOWN_DIR=data/processed/fact_data
ADSP_FACTDATA_MARKDOWN_PATTERN=*.md
ADSP_FACTDATA_RUN_EXTRACTION=false

# Embedding model configuration
ADSP_EMBEDDING_BACKEND=huggingface
ADSP_EMBEDDING_MODEL_NAME=sentence-transformers/all-mpnet-base-v2
# `auto` picks the best available device: `cuda`, then `mps`, else `cpu`
ADSP_EMBEDDING_DEVICE=auto
ADSP_EMBEDDING_BATCH_SIZE=
# OpenAI-compatible embeddings backend settings (for example, NVIDIA NIM)
ADSP_EMBEDDING_API_BASE_URL=
ADSP_EMBEDDING_API_KEY=
ADSP_EMBEDDING_ENCODING_FORMAT=float
ADSP_EMBEDDING_EXTRA_BODY=
ADSP_EMBEDDING_QUERY_EXTRA_BODY=
ADSP_EMBEDDING_DOCUMENT_EXTRA_BODY=
# Example for NVIDIA NIM retrieval models:
#ADSP_EMBEDDING_BACKEND=openai
#ADSP_EMBEDDING_MODEL_NAME=nvidia/llama-nemotron-embed-vl-1b-v2
#ADSP_EMBEDDING_API_BASE_URL=https://integrate.api.nvidia.com/v1
#ADSP_EMBEDDING_ENCODING_FORMAT=float
#ADSP_EMBEDDING_API_KEY={YOUR_API_KEY}
#ADSP_EMBEDDING_QUERY_EXTRA_BODY={"input_type":"query","truncate":"NONE"}
#ADSP_EMBEDDING_DOCUMENT_EXTRA_BODY={"input_type":"passage","truncate":"NONE"}

# PyTorch runtime bootstrap (docker-compose)
# Default installs CUDA wheels so `ADSP_EMBEDDING_DEVICE=cuda` can work at runtime.
ADSP_TORCH_INSTALL_ENABLED=true
ADSP_TORCH_EXPECT_CUDA=true
ADSP_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
ADSP_TORCH_PACKAGES=torch torchvision torchaudio
ADSP_TORCH_FORCE_REINSTALL=false

# LangChain vector store backend
# Supported backends: `faiss` (default), `chroma`, `milvus`
ADSP_VECTORSTORE_BACKEND=faiss
ADSP_VECTORSTORE_PERSIST_DIR=data/processed/vectorstores
ADSP_VECTORSTORE_COLLECTION_PREFIX=adsp
ADSP_VECTORSTORE_RESET_ON_STARTUP=false
ADSP_VECTORSTORE_MILVUS_URI=http://localhost:19530
ADSP_VECTORSTORE_MILVUS_TOKEN=
ADSP_VECTORSTORE_MILVUS_DB_NAME=

# Persona extraction pipeline (scripts/run_persona_extraction.py)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=
VLLM_API_KEY=EMPTY

# Optional extraction request tuning
TEMPERATURE=0.0
TOP_P=0.01
MAX_TOKENS=100000
RESPONSE_TIMEOUT=300.0
VLLM_MAX_CONCURRENT_REQUESTS=4
VLM_MAX_RETRIES=3
VLLM_BACKOFF_SECONDS=1

# Optional reasoning enrichment model (can reuse the same endpoint)
REASONING_BASE_URL=http://localhost:8000/v1
REASONING_MODEL=
REASONING_API_KEY=EMPTY

# Optional reasoning model tuning
REASONING_TEMPERATURE=0.0
REASONING_TOP_P=0.01
REASONING_MAX_TOKENS=100000
REASONING_MAX_INPUT_CHARS=100000
REASONING_MAX_CONCURRENT=4

# Docker Compose pipeline controls (docker-compose.yml)
# Required: source PDF path used by both extraction jobs.
PERSONA_PDF_PATH=data/raw/
FACT_DATA_PDF_PATH=data/raw/

# Optional page ranges: "start,end" (1-based, inclusive). Leave blank to process full PDF.
PERSONA_PAGE_RANGE=
FACT_PAGE_RANGE=

# Optional extraction toggles/extra args.
PERSONA_DEBUG=false
PERSONA_NO_CACHE=false
PERSONA_DISABLE_REASONING_PROFILES=false
PERSONA_EXTRA_ARGS=
FACT_DEBUG=false
FACT_NO_CACHE=false
FACT_EXTRA_ARGS=

# Frontend container defaults.
ADSP_FE_PORT=8501
ADSP_FE_API_URL=http://api:8000
